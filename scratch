// workflow.mjs — a self-contained multi-agent Workflow engine on the Claude Agent SDK.
//
// This is a distilled, single-file reimplementation of the orchestration engine that ships
// inside Claude Code (the `Workflow` tool). A "workflow" is a plain-JS *script* that acts as
// a deterministic coordinator: it spawns subagents with agent(), decides what runs
// concurrently (parallel) vs streamed per-item (pipeline), and threads each agent's return
// value into the next step. The engine below is the management shell around that script:
//
//   • node:vm sandbox + injected globals   the script can only touch what we inject
//   • counting semaphore @ min(16, cores-2) caps how many agents run at once
//   • 1000-agent lifetime backstop          runaway-loop guard
//   • token budget                          optional hard output-token ceiling for the run
//
// Each agent() is ONE `query()` call against the Agent SDK. The subagent gets that runtime's
// own built-in tools (Bash, Read, Write, Grep, WebSearch, ...) and its own isolated context —
// so the engine never hand-writes a tool loop; it only orchestrates.
//
// Requires: npm i @anthropic-ai/claude-agent-sdk   (v0.3.x+, for native structured outputs)
// Auth: uses your existing Claude Code login — no ANTHROPIC_API_KEY needed.

import os from 'node:os';
import vm from 'node:vm';
import { query } from '@anthropic-ai/claude-agent-sdk';

// Concurrency cap — identical to Claude Code's Workflow engine.
const CAP_DEFAULT = Math.min(16, Math.max(2, os.cpus().length - 2));
const AGENT_LIFETIME_CAP = 1000; // runaway-loop backstop, far above any real workflow

// Friendly model aliases → exact IDs (omit to inherit the SDK default).
const MODELS = {
  opus: 'claude-opus-4-8',
  sonnet: 'claude-sonnet-4-6',
  haiku: 'claude-haiku-4-5',
};

// Textbook counting semaphore: admits up to `max` concurrent runs, queues the rest.
function semaphore(max) {
  let active = 0;
  const queue = [];
  return (fn) => async (...args) => {
    if (active >= max) await new Promise((r) => queue.push(r));
    active++;
    try {
      return await fn(...args);
    } finally {
      active--;
      queue.shift()?.();
    }
  };
}

const slug = (s) =>
  String(s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 48) || 'agent';

/**
 * Run a workflow script.
 * @param {string} src   The workflow script (plain JavaScript). Gets agent/parallel/pipeline/
 *                       phase/log/budget/args injected as globals. May `return` a value.
 * @param {object} [opts]
 * @param {any}    [opts.args]         value exposed to the script as the global `args`
 * @param {string} [opts.cwd]          working dir the subagents operate in
 * @param {number|null} [opts.tokenBudget]  hard OUTPUT-token ceiling for the whole run (null = unlimited)
 * @param {number} [opts.concurrency]  max concurrent agents (default min(16, cores-2))
 * @param {(e:object)=>void} [opts.onEvent]  progress callback — wire this to your TUI
 * @returns {Promise<{result:any, agents:number, spentTokens:number, costUsd:number, logs:string[]}>}
 */
export async function runWorkflow(src, opts = {}) {
  const {
    args,
    cwd = process.cwd(),
    tokenBudget = null,
    concurrency = CAP_DEFAULT,
    onEvent = () => {},
  } = opts;

  const limit = semaphore(concurrency);
  let count = 0;          // lifetime agent count
  let spentTokens = 0;    // summed output tokens (drives budget)
  let costUsd = 0;        // summed USD
  let currentPhase = null;
  const logs = [];

  const checkLimits = () => {
    if (count >= AGENT_LIFETIME_CAP) {
      throw new Error(
        `Agent lifetime cap (${AGENT_LIFETIME_CAP}) reached — almost certainly a runaway loop. ` +
          'Add a hard iteration cap, or guard budget loops on `budget.total &&`.',
      );
    }
    if (tokenBudget != null && spentTokens >= tokenBudget) {
      throw new Error(`Token budget exceeded (${spentTokens} / ${tokenBudget} output tokens).`);
    }
  };

  // ── the core primitive: one subagent = one query() call ────────────────────────────────
  const rawAgent = async (prompt, agentOpts = {}) => {
    checkLimits();
    const n = ++count;
    const phase = agentOpts.phase ?? currentPhase ?? 'main';
    const label = agentOpts.label ?? slug(prompt.slice(0, 48));
    onEvent({ type: 'agent:start', phase, label, n });

    // Map a friendly alias to an exact model id; pass anything else through verbatim.
    const model = agentOpts.model
      ? (Object.hasOwn(MODELS, agentOpts.model) ? MODELS[agentOpts.model] : agentOpts.model)
      : undefined;

    const systemPrompt = agentOpts.schema
      ? 'You are a subagent in a workflow. Complete the task using your tools, then emit your ' +
        'answer via the structured-output schema. Return data, not chatter.'
      : 'You are a subagent in a workflow. Use your tools to complete the task. Your final ' +
        'message is returned verbatim to the caller — return the raw answer or data, not chatter.';

    const options = {
      cwd,
      systemPrompt,
      permissionMode: 'bypassPermissions',          // headless: never block on a permission prompt
      maxTurns: agentOpts.maxTurns ?? (agentOpts.tools ? 40 : 6),
      ...(model ? { model } : {}),
      ...(agentOpts.tools ? { allowedTools: agentOpts.tools } : {}),
      ...(agentOpts.mcpServers ? { mcpServers: agentOpts.mcpServers } : {}),
      // Native structured output (Agent SDK v0.3.x+): validated JSON in result.structured_output.
      ...(agentOpts.schema
        ? { outputFormat: { type: 'json_schema', schema: agentOpts.schema } }
        : {}),
    };

    let out = null;
    let failed = null;
    const t0 = Date.now();
    for await (const message of query({ prompt, options })) {
      if (message?.type === 'result') {
        spentTokens += message.usage?.output_tokens ?? 0;
        costUsd += message.total_cost_usd ?? 0;
        if (message.is_error) { failed = message.subtype; break; }
        out = agentOpts.schema ? message.structured_output : (message.result ?? '').trim();
      }
    }

    if (failed) {
      onEvent({ type: 'agent:error', phase, label, n, error: failed });
      return null;                                  // mirror Workflow: a dead agent → null
    }
    onEvent({ type: 'agent:done', phase, label, n, ms: Date.now() - t0 });
    return out;
  };

  // ── globals injected into the workflow script ──────────────────────────────────────────
  const agent = limit(rawAgent); // semaphore-wrapped: enforces the concurrency cap

  // parallel(thunks): BARRIER fan-out — awaits all, errors resolve to null.
  const parallel = (thunks) =>
    Promise.all(thunks.map((t) => Promise.resolve().then(t).catch(() => null)));

  // pipeline(items, ...stages): NO-barrier per-item chain. Item A can be in stage 3 while item
  // B is still in stage 1. Each stage gets (prevResult, originalItem, index). A throw drops
  // that item to null and skips its remaining stages.
  const pipeline = (items, ...stages) =>
    Promise.all(
      items.map(async (item, i) => {
        let acc = item;
        for (const stage of stages) {
          if (acc === null) return null;
          try { acc = await stage(acc, item, i); }
          catch { return null; }
        }
        return acc;
      }),
    );

  const phase = (title) => { currentPhase = title; onEvent({ type: 'phase', title }); };
  const log = (message) => { logs.push(message); onEvent({ type: 'log', message }); };
  const budget = {
    total: tokenBudget,
    spent: () => spentTokens,
    remaining: () => (tokenBudget == null ? Infinity : Math.max(0, tokenBudget - spentTokens)),
  };

  // ── run the script in a vm sandbox with only the injected globals visible ───────────────
  const sandbox = { agent, parallel, pipeline, phase, log, budget, args, console, JSON, Math, Object, Array, Promise };
  vm.createContext(sandbox);
  // Wrap so the script body can use top-level await and `return`.
  const wrapped = `(async () => {\n${src}\n})()`;
  const result = await vm.runInContext(wrapped, sandbox, { timeout: 0 });

  return { result, agents: count, spentTokens, costUsd, logs };
}
